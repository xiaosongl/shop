# 复制成 .env 后按需修改

DATABASE_URL="file:./data/shop.db"

# 站点主域名。站内链接一律相对路径，这个只用于 canonical、og:url 和分享卡片。
# 域名被封需要更换时，改这一行重启即可。
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Host 白名单，逗号分隔。不在名单里的 Host（比如拿服务器 IP 直连）一律 404，
# 避免裸 IP 页面被爬到收录。留空表示不校验（本地开发默认不校验）。
ALLOWED_HOSTS=""

# 备用域名，逗号分隔，带 https://。主域被微信/QQ 标红时，
# 防红引导层会把这些地址展示给访客，让他们还有地方回来。
BACKUP_DOMAINS=""

# 加密货币收款地址不在这里配——每个币+链一个地址，改起来太频繁，
# 放在后台「收款配置」页（/admin/payments），存数据库。

# 客服 WhatsApp 号，纯数字带国家码（例如 8613800138000）。
# 留空则前台不显示本地支付选项。
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# 后台账号。ADMIN_SESSION_SECRET 用于给登录 cookie 签名，上线前务必换成随机串。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# 一键部署：本机 npm run deploy 会 ssh 到这里执行 scripts/deploy.sh
#   普通 ssh： DEPLOY_HOST="ubuntu@34.12.34.56"
#   gcloud：  DEPLOY_HOST="gcloud:实例名:区域"
DEPLOY_HOST=""
DEPLOY_PATH="/opt/shop"
